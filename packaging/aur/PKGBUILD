# Maintainer: Daniel <daniel@example.com>

pkgname=widdgyy-git
pkgver=r52.g24c46eb
pkgrel=1
pkgdesc="GPU-accelerated Wayland layer-shell desktop ricing engine (Rust + Vello)"
arch=('x86_64')
url="https://github.com/dantejvar28/widdgyy"
license=('GPL-3.0-or-later')
depends=(
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'wayland'
  'vulkan-icd-loader'
)
optdepends=(
  'gst-plugins-bad: extra video codecs'
  'gst-libav: H.264/H.265 decoding'
)
makedepends=(
  'git'
  'cargo'
  'rust'
)
provides=('widdgyy')
conflicts=('widdgyy')
source=("${pkgname}::git+https://github.com/dantejvar28/widdgyy.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${srcdir}/${pkgname}"
  # makepkg's CFLAGS/LDFLAGS (notably LTO/as-needed) can break ring's
  # assembly objects. Rust manages its own flags via the Cargo profile.
  unset CFLAGS CXXFLAGS LDFLAGS RUSTFLAGS
  # Keep build artifacts out of the cloned repository / package source tree.
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo build --release --locked
}

package() {
  cd "${srcdir}/${pkgname}"

  install -Dm755 "${srcdir}/target/release/widdgyy" "${pkgdir}/usr/bin/widdgyy"

  install -dm755 "${pkgdir}/usr/share/widdgyy"
  if [[ -d assets ]]; then
    cp -r assets "${pkgdir}/usr/share/widdgyy/"
  fi
  install -m644 README.md "${pkgdir}/usr/share/widdgyy/README.md"
  install -m644 "docs/Configuration & Styling Guide.md" \
    "${pkgdir}/usr/share/widdgyy/Configuration & Styling Guide.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
