#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
BIN="${ROOT_DIR}/target/release/widdgyy"

if [[ ! -x "${BIN}" || "${ROOT_DIR}/Cargo.toml" -nt "${BIN}" ]]; then
  echo "Building widdgyy (release)..." >&2
  (cd "${ROOT_DIR}" && cargo build --release --locked)
fi

exec "${BIN}" "$@"
